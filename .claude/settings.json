{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Program Files\\nodejs\\node.exe",
            "args": [
              "C:\\Users\\Ian\\OneDrive\\Documents\\claude_projects\\.claude\\claim-op.mjs"
            ],
            "timeout": 15,
            "statusMessage": "Reserving this session's op number"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Program Files\\nodejs\\node.exe",
            "args": [
              "C:\\Users\\Ian\\OneDrive\\Documents\\claude_projects\\.claude\\worktree-create.mjs"
            ],
            "timeout": 60
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Program Files\\nodejs\\node.exe",
            "args": [
              "C:\\Users\\Ian\\OneDrive\\Documents\\claude_projects\\.claude\\worktree-remove.mjs"
            ],
            "timeout": 60
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git remote *)",
      "Bash(git ls-remote *)",
      "Bash(git --version)",
      "Bash(git fsck *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git revert *)",
      "Bash(npm install *)",
      "Bash(npm ci *)",
      "Bash(npm run *)",
      "Bash(npm list *)",
      "Bash(npx astro *)",
      "Bash(npx lighthouse *)",
      "Bash(gh repo *)",
      "Bash(gh api *)",
      "Bash(gh workflow *)",
      "Bash(gh run *)",
      "Bash(gh pr *)",
      "Bash(netlify --version)",
      "Bash(netlify status *)",
      "Bash(netlify sites:*)",
      "Bash(netlify deploy *)",
      "Bash(npx netlify *)",
      "Bash(curl -s *)",
      "Bash(curl -sI *)"
    ]
  }
}
