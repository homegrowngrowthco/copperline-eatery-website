# ============================================================
# Daily Specials Email Pipeline — required environment variables
# ============================================================
# All of these are set in Netlify Site Settings -> Environment Variables.
# Local dev (netlify dev) reads them from a local .env (gitignored).

# ---- Anthropic ----
# API key for the Claude vision call that extracts specials from the photo.
ANTHROPIC_API_KEY=

# ---- Postmark (inbound + outbound email) ----
# Server token for the Postmark server hosting both the inbound stream
# and the outbound replies. Found in Postmark -> Servers -> API Tokens.
POSTMARK_SERVER_TOKEN=

# Basic-auth credentials for the inbound webhook. Set these on the
# Postmark inbound webhook URL: https://USER:PASS@<site>/.netlify/functions/inbound-email
POSTMARK_WEBHOOK_USER=
POSTMARK_WEBHOOK_PASS=

# The "From" address used for confirmation replies. Must be a verified
# sender signature in Postmark (typically on the parse subdomain).
SPECIALS_FROM_ADDRESS=specials-bot@parse.copperlineeatery.com

# ---- Allowlist ----
# Comma-separated list of email addresses allowed to send specials photos.
# Anything from another address is silently dropped.
ALLOWED_SENDER_EMAILS=

# ---- GitHub (writes confirmed specials back to the repo) ----
# Fine-grained PAT or GitHub App token with contents:write on the repo.
GITHUB_TOKEN=
GITHUB_REPO=homegrowngrowthco/copperline-eatery-website
GITHUB_BRANCH=master
