---
// The /catering/quote builder: a single Netlify Form rendered as five steps.
//
// Every input is present in the static HTML at build time, because Netlify
// detects a form's fields by parsing the deployed HTML. Anything JavaScript
// creates at runtime is silently dropped from the submission, so the script
// only shows, hides, limits, and totals what is already here.
//
// Picking a buffet (step 3) advances straight into that buffet's own build
// screen (step 4), so nobody has to scroll past nine packages to reach their
// dishes. Dishes are selectable cards, not form controls, with an order
// summary that fills in beside them.
//
// Prices, options, and the service/tax rates come from cateringPackages.ts
// (derived from menuData.json), never from copy typed into this file.
import {
  CHOICE_PACKAGES,
  SERVICE_CHARGE_RATE,
  SET_PACKAGES,
  TAX_RATE,
  formatPrice,
  percent,
} from '../data/cateringPackages';
import type { CateringPackage, ChoiceGroup } from '../data/cateringPackages';
import { ADDRESS, EMAIL, PHONE, PHONE_DISPLAY } from '../data/restaurant';

// The NAP line on the print sheet is clickable in the saved PDF.
const MAPS_URL = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(
  `${ADDRESS.streetAddress}, ${ADDRESS.addressLocality}, ${ADDRESS.addressRegion} ${ADDRESS.postalCode}`
)}`;

const ALL_PACKAGES: CateringPackage[] = [...SET_PACKAGES, ...CHOICE_PACKAGES];

// Options inside a group can carry a sub-heading (chicken vs beef & seafood).
function sectionsOf(group: ChoiceGroup): { name: string; options: typeof group.options }[] {
  const order: string[] = [];
  const bySection = new Map<string, typeof group.options>();
  for (const option of group.options) {
    const key = option.section ?? '';
    if (!bySection.has(key)) {
      bySection.set(key, []);
      order.push(key);
    }
    bySection.get(key)!.push(option);
  }
  return order.map((name) => ({ name, options: bySection.get(name)! }));
}

function singular(label: string): string {
  return label.replace(/s$/, '');
}

function chooseHint(group: ChoiceGroup): string {
  return `Choose ${group.min} ${group.min === 1 ? singular(group.label).toLowerCase() : group.label.toLowerCase()}`;
}
---

<form
  name="catering-quote"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  action="/catering-thanks"
  class="quote-form"
  id="quoteForm"
  data-service-rate={SERVICE_CHARGE_RATE}
  data-tax-rate={TAX_RATE}
>
  <input type="hidden" name="form-name" value="catering-quote" />
  <input type="hidden" name="source" value="quote-builder" />
  <p class="hidden-field" aria-hidden="true">
    <label>Don't fill this out if you're human: <input name="bot-field" /></label>
  </p>

  <ol class="quote-progress" id="quoteProgress" aria-label="Quote steps">
    <li data-step="1" class="active"><span>1</span> Your info</li>
    <li data-step="2"><span>2</span> Your event</li>
    <li data-step="3"><span>3</span> Pick a buffet</li>
    <li data-step="4"><span>4</span> Your menu</li>
    <li data-step="5"><span>5</span> Your estimate</li>
  </ol>

  <noscript>
    <p class="quote-noscript">
      The live estimate needs JavaScript. With it off you can still send the form below, or call us
      at <a href="tel:+14135948332">{PHONE_DISPLAY}</a> and we'll build the menu with you over the phone.
    </p>
  </noscript>

  <!-- Step 1: contact -->
  <section class="quote-step active" data-step="1">
    <fieldset>
      <legend class="quote-legend">Who should we get back to?</legend>
      <div class="form-row">
        <div class="form-field">
          <label for="q-name">Your name *</label>
          <input id="q-name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="form-field">
          <label for="q-phone">Phone *</label>
          <input id="q-phone" name="phone" type="tel" required autocomplete="tel" />
        </div>
      </div>
      <div class="form-field">
        <label for="q-email">Email *</label>
        <input id="q-email" name="email" type="email" required autocomplete="email" />
      </div>
    </fieldset>
    <div class="quote-nav">
      <button type="button" class="btn btn-primary quote-next" data-next="2">Next: your event</button>
    </div>
  </section>

  <!-- Step 2: event -->
  <section class="quote-step" data-step="2">
    <fieldset>
      <legend class="quote-legend">Tell us about the event</legend>
      <div class="form-row">
        <div class="form-field">
          <label for="q-date">Event date</label>
          <input id="q-date" name="event-date" type="date" />
        </div>
        <div class="form-field">
          <label for="q-guests">Guest count *</label>
          <input id="q-guests" name="guest-count" type="number" min="1" step="1" inputmode="numeric" required />
        </div>
      </div>
      <div class="form-row">
        <div class="form-field">
          <label for="q-town">Event town/city</label>
          <input id="q-town" name="event-town" type="text" placeholder="e.g. Springfield, MA" />
        </div>
        <div class="form-field">
          <label for="q-type">Event type</label>
          <select id="q-type" name="event-type">
            <option value="">Choose one (optional)</option>
            <option>Corporate / office</option>
            <option>Wedding / rehearsal</option>
            <option>Shower / graduation / birthday</option>
            <option>Holiday party</option>
            <option>Memorial service</option>
            <option>Church / school / community</option>
            <option>Other</option>
          </select>
        </div>
      </div>
      <div class="form-field">
        <label for="q-service">How should we serve it?</label>
        <select id="q-service" name="service-style">
          <option value="">Choose one (optional)</option>
          <option>On-site service at my venue</option>
          <option>Drop-off, hot and ready</option>
          <option>Pick-up at 409 Broadway, Chicopee</option>
          <option>Not sure yet</option>
        </select>
      </div>
    </fieldset>
    <div class="quote-nav">
      <button type="button" class="btn btn-secondary quote-back" data-back="1">Back</button>
      <button type="button" class="btn btn-primary quote-next" data-next="3">Next: pick a buffet</button>
    </div>
  </section>

  <!-- Step 3: pick a buffet. Choosing one jumps straight to its build screen. -->
  <section class="quote-step" data-step="3">
    <fieldset>
      <legend class="quote-legend">Pick a buffet</legend>
      <p class="quote-help">
        All prices are per person. Choose one and we'll open it up so you can build it.
      </p>

      <h3 class="quote-group-title">Set buffets</h3>
      <p class="quote-help">Everything is chosen for you.</p>
      <div class="pkg-grid">
        {
          SET_PACKAGES.map((pkg) => (
            <label class="pkg-card">
              <input
                type="radio"
                name="package"
                value={pkg.name}
                class="pkg-input"
                data-pkg={pkg.id}
                data-price={pkg.basePrice}
                data-min-guests={pkg.minGuests}
              />
              <span class="pkg-card-body">
                <span class="pkg-card-head">
                  <span class="pkg-name">
                    {pkg.name}
                    {pkg.popular && <span class="pkg-flag">Most popular</span>}
                  </span>
                  <span class="pkg-price">
                    {formatPrice(pkg.basePrice)} <small>per person</small>
                  </span>
                </span>
                <span class="pkg-items">
                  {pkg.includes.map((item) => (
                    <span class="pkg-item">
                      {item.name}
                      {item.detail && <span class="pkg-item-detail">{item.detail}</span>}
                    </span>
                  ))}
                </span>
              </span>
            </label>
          ))
        }
      </div>

      <h3 class="quote-group-title">Choose your entrees</h3>
      <p class="quote-help">You pick the dishes on these.</p>
      <div class="pkg-grid">
        {
          CHOICE_PACKAGES.map((pkg) => (
            <label class="pkg-card">
              <input
                type="radio"
                name="package"
                value={pkg.name}
                class="pkg-input"
                data-pkg={pkg.id}
                data-price={pkg.basePrice}
                data-min-guests={pkg.minGuests}
              />
              <span class="pkg-card-body">
                <span class="pkg-card-head">
                  <span class="pkg-headline">
                    <span class="pkg-name">
                      {pkg.name}
                      {pkg.popular && <span class="pkg-flag">Most popular</span>}
                    </span>
                    {pkg.includes.length > 0 && (
                      <span class="pkg-included">
                        Includes {pkg.includes.map((i) => i.name).join(', ').toLowerCase()}
                      </span>
                    )}
                  </span>
                  <span class="pkg-price">
                    {formatPrice(pkg.basePrice)} <small>per person</small>
                  </span>
                </span>
                <span class="pkg-items">
                  {pkg.groups.map((group) => (
                    <span class="pkg-item">{chooseHint(group)}</span>
                  ))}
                </span>
                {pkg.minGuests > 1 && <span class="pkg-min">Minimum {pkg.minGuests} guests</span>}
              </span>
            </label>
          ))
        }
      </div>
      <p class="quote-error" id="quotePackageError" role="alert" hidden></p>
    </fieldset>
    <div class="quote-nav">
      <button type="button" class="btn btn-secondary quote-back" data-back="2">Back</button>
      <button type="button" class="btn btn-primary quote-next" data-next="4">Next: your menu</button>
    </div>
  </section>

  <!-- Step 4: build the chosen buffet -->
  <section class="quote-step" data-step="4">
    <div class="menu-layout">
      <div class="menu-choices">
        <fieldset>
          <legend class="quote-legend">Build your menu</legend>
          {
            ALL_PACKAGES.map((pkg) => (
              <div class="pkg-panel" data-panel={pkg.id} hidden>
                <div class="pkg-panel-head">
                  <h3 class="pkg-panel-title">{pkg.name}</h3>
                  <span class="pkg-panel-price">{formatPrice(pkg.basePrice)} per person</span>
                </div>
                {pkg.includes.length > 0 && (
                  <p class="pkg-panel-includes">
                    <strong>Comes with:</strong>{' '}
                    {pkg.includes
                      .map((i) => (i.detail ? `${i.name} (${i.detail})` : i.name))
                      .join(', ')}
                  </p>
                )}
                {pkg.groups.length === 0 && (
                  <p class="pkg-panel-set">
                    This buffet is set, so there is nothing to choose. Head straight to your estimate.
                  </p>
                )}
                {pkg.groups.map((group) => (
                  <fieldset
                    class="dish-group"
                    data-group={group.id}
                    data-label={group.label}
                    data-min={group.min}
                    data-max={group.max}
                    data-multi={group.multi ? 'true' : 'false'}
                  >
                    <legend class="dish-legend">
                      <span class="dish-legend-name">{group.label}</span>
                      <span class="dish-count" data-count>
                        0 of {group.max} picked
                      </span>
                    </legend>
                    <p class="dish-swap" data-swap hidden>
                      That's all {group.max}. Tap a picked dish to swap it out.
                    </p>
                    {sectionsOf(group).map((sec) => (
                      <>
                        {sec.name && <p class="dish-section">{sec.name}</p>}
                        <div class="dish-grid">
                          {sec.options.map((option) => (
                            <label class="dish">
                              <input
                                type={group.multi ? 'checkbox' : 'radio'}
                                name={group.multi ? undefined : `${pkg.id}-${group.id}`}
                                value={option.name}
                                class="dish-input"
                                data-upcharge={option.upcharge}
                                data-label={option.name}
                                data-section={option.section ?? ''}
                              />
                              <span class="dish-body">
                                <span class="dish-check" aria-hidden="true" />
                                <span class="dish-text">
                                  <span class="dish-name">{option.name}</span>
                                  {option.note && <span class="dish-note">{option.note}</span>}
                                </span>
                                {option.upcharge > 0 && (
                                  <span class="dish-badge">+{formatPrice(option.upcharge)}/person</span>
                                )}
                              </span>
                            </label>
                          ))}
                        </div>
                      </>
                    ))}
                  </fieldset>
                ))}
              </div>
            ))
          }
        </fieldset>

        <p class="quote-error" id="quoteMenuError" role="alert" hidden></p>
        <div class="quote-nav">
          <button type="button" class="btn btn-secondary quote-back" data-back="3">
            Back to buffets
          </button>
          <button type="button" class="btn btn-primary quote-next" data-next="5">
            Next: see your estimate
          </button>
        </div>
      </div>

      <!-- Order summary: fills in as they pick, sticky alongside the dishes. -->
      <aside class="menu-summary" id="menuSummary" aria-live="polite" hidden>
        <div class="menu-summary-inner">
          <h3 class="menu-summary-title">Your menu</h3>
          <p class="menu-summary-pkg" id="summaryPackage"></p>
          <ul class="menu-summary-list" id="summaryList"></ul>
          <div class="menu-summary-totals">
            <div class="menu-summary-row">
              <span>Per person</span>
              <strong id="summaryPerPerson">$0.00</strong>
            </div>
            <div class="menu-summary-row">
              <span>Guests</span>
              <strong id="summaryGuests">0</strong>
            </div>
            <div class="menu-summary-row menu-summary-row--total">
              <span>Estimated total</span>
              <strong id="summaryTotal">$0.00</strong>
            </div>
          </div>
          <p class="menu-summary-todo" id="summaryTodo"></p>
        </div>
      </aside>
    </div>
  </section>

  <!-- Step 5: review + estimate + submit -->
  <section class="quote-step" data-step="5">
    <fieldset>
      <legend class="quote-legend">Review and send</legend>

      <div class="review-grid">
        <div class="review-block">
          <div class="review-head">
            <h3>Your info</h3>
            <button type="button" class="review-edit" data-goto="1">Edit</button>
          </div>
          <dl class="review-list" id="reviewContact"></dl>
        </div>
        <div class="review-block">
          <div class="review-head">
            <h3>Your event</h3>
            <button type="button" class="review-edit" data-goto="2">Edit</button>
          </div>
          <dl class="review-list" id="reviewEvent"></dl>
        </div>
      </div>

      <div class="estimate-card" aria-live="polite">
        <div class="review-head">
          <h3 class="estimate-title" id="estimatePackage">No buffet picked yet</h3>
          <button type="button" class="review-edit" data-goto="4">Edit</button>
        </div>
        <dl class="review-list estimate-menu" id="estimateLines"></dl>

        <div class="estimate-totals">
          <div class="estimate-row">
            <span>Per person</span>
            <strong id="estimatePerPerson">$0.00</strong>
          </div>
          <div class="estimate-row">
            <span>Guests</span>
            <strong id="estimateGuests">0</strong>
          </div>
          <div class="estimate-row">
            <span>Food subtotal</span>
            <strong id="estimateFood">$0.00</strong>
          </div>
          <div class="estimate-row">
            <span>Service charge ({percent(SERVICE_CHARGE_RATE)})</span>
            <strong id="estimateService">$0.00</strong>
          </div>
          <div class="estimate-row">
            <span>Tax ({percent(TAX_RATE)})</span>
            <strong id="estimateTax">$0.00</strong>
          </div>
          <div class="estimate-row estimate-row--total">
            <span>Estimated total</span>
            <strong id="estimateTotal">$0.00</strong>
          </div>
        </div>

        <p class="estimate-note">
          <strong>All prices are estimates.</strong>
          <span>
            This covers food, a {percent(SERVICE_CHARGE_RATE)} service charge, and{' '}
            {percent(TAX_RATE)} tax. Delivery and on-site staffing are quoted separately, and the
            final menu is confirmed with you before anything is booked.
          </span>
        </p>

        <div class="estimate-actions">
          <button type="button" class="btn btn-secondary" id="quotePrint">Save as PDF</button>
          <span class="estimate-actions-note">Opens your browser's print dialog, then choose "Save as PDF".</span>
        </div>
      </div>

      <div class="form-field">
        <label for="q-allergies">Allergies or dietary needs</label>
        <textarea
          id="q-allergies"
          name="allergies"
          rows="3"
          placeholder="Nut allergy, gluten free, vegetarian guests, anything the kitchen needs to know."
        ></textarea>
      </div>

      <div class="form-field">
        <label for="q-notes">Anything else we should know?</label>
        <textarea
          id="q-notes"
          name="notes"
          rows="4"
          placeholder="Venue details, timing, a dish you don't see here, or anything else."
        ></textarea>
      </div>
    </fieldset>

    <textarea name="menu-selection" id="quoteSelection" hidden readonly></textarea>
    <input type="hidden" name="per-person" id="quotePerPerson" />
    <input type="hidden" name="food-subtotal" id="quoteFood" />
    <input type="hidden" name="service-charge" id="quoteService" />
    <input type="hidden" name="tax" id="quoteTax" />
    <input type="hidden" name="estimated-total" id="quoteTotal" />

    <p class="quote-error" id="quoteSubmitError" role="alert" hidden></p>
    <div class="quote-nav">
      <button type="button" class="btn btn-secondary quote-back" data-back="4">Back</button>
      <button type="submit" class="btn btn-primary catering-form-submit">Send My Quote Request</button>
    </div>
  </section>

  <div class="quote-bar" id="quoteBar" hidden>
    <div class="quote-bar-inner container">
      <span class="quote-bar-label" id="quoteBarLabel">Pick a buffet</span>
      <span class="quote-bar-total" id="quoteBarTotal"></span>
    </div>
  </div>
</form>

<!-- Print-only quote sheet. Hidden on screen; the only thing that prints. -->
<section class="print-sheet" id="printSheet" aria-hidden="true">
  <header class="print-head">
    <img class="print-logo" src="/logo.jpg" alt="The Copperline Eatery" width="300" height="300" />
    <p class="print-nap">
      <a href={MAPS_URL}>
        {ADDRESS.streetAddress}, {ADDRESS.addressLocality}, {ADDRESS.addressRegion}{' '}
        {ADDRESS.postalCode}
      </a>
      <span aria-hidden="true"> &middot; </span>
      <a href={`tel:${PHONE.replace(/[^+\d]/g, '')}`}>{PHONE_DISPLAY}</a>
      <span aria-hidden="true"> &middot; </span>
      <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
    </p>
    <h2 class="print-title">Catering Estimate</h2>
    <p id="printDate"></p>
  </header>
  <div class="print-cols">
    <div>
      <h4>Your info</h4>
      <dl id="printContact"></dl>
    </div>
    <div>
      <h4>Your event</h4>
      <dl id="printEvent"></dl>
    </div>
  </div>
  <h4 id="printPackage"></h4>
  <dl id="printMenu"></dl>
  <!-- Side by side, not stacked: two stacked free-text blocks push the sheet
       onto a second page. -->
  <div class="print-cols">
    <div id="printAllergiesBlock" hidden>
      <h4>Allergies &amp; dietary needs</h4>
      <p id="printAllergies"></p>
    </div>
    <div id="printNotesBlock" hidden>
      <h4>Notes</h4>
      <p id="printNotes"></p>
    </div>
  </div>
  <h4>Estimate</h4>
  <dl id="printTotals"></dl>
  <p class="print-note">
    <strong>All prices are estimates.</strong> This catering quote does not represent a confirmed booking or invoice. Final menu and pricing will be confirmed with you before booking.
  </p>
</section>
