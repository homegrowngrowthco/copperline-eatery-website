---
// Compact catering packages + pricing block, rendered from menuData.json so
// the numbers can never drift from the menu page or the printed PDFs.
// Used on /catering and every /catering/<town> page.
import menuData from '../data/menuData.json';

interface Props {
  /** Show the link row under the packages (default true). */
  links?: boolean;
}

const { links = true } = Astro.props;

interface Section {
  id: string;
  name: string;
  service: string;
  note?: string;
  included?: string[];
  items: Array<{ name: string; price?: string }>;
}

const cateringSections = (menuData.sections as Section[]).filter((s) => s.service === 'catering');

function priceRange(items: Array<{ price?: string }>): string {
  const prices = items.map((i) => parseFloat(i.price || '')).filter((n) => !isNaN(n));
  if (!prices.length) return '';
  const min = Math.min(...prices);
  const max = Math.max(...prices);
  return min === max ? `$${min.toFixed(2)}` : `$${min.toFixed(2)} - $${max.toFixed(2)}`;
}
---

<div class="catering-packages">
  {cateringSections.map((section) => (
    <div class="catering-package-card">
      <h3>{section.name}</h3>
      <p class="catering-package-price">{priceRange(section.items)} <span>per person</span></p>
      {section.note && <p class="catering-package-note">{section.note}</p>}
      {section.included && (
        <p class="catering-package-includes">Includes {section.included.join(', ').toLowerCase()}.</p>
      )}
    </div>
  ))}
</div>
<p class="catering-packages-fees">Prices do not include 7% Massachusetts meal tax and 15% service fee. Custom menus available, tell us what your event needs.</p>
{links && (
  <p class="catering-packages-links">
    <a href="/menu#catering">See the full catering menu</a> &nbsp;&middot;&nbsp;
    <a href="/catering-menu.pdf" download>Download the catering menu (PDF)</a> &nbsp;&middot;&nbsp;
    <a href="/catering-order-form.pdf" download>Order form (PDF)</a>
  </p>
)}
