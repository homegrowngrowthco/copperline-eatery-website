---
import specialsData from '../data/specials.json';

interface Special {
  name: string;
  description: string | null;
  price: string | null;
}

interface Board {
  key: string;
  contentType?: string;
}

interface Credit {
  name: string;
  from?: string;
}

interface SpecialsFile {
  updatedAt?: string | null;
  board?: Board;
  credit?: Credit | null;
  specials?: Special[];
}

const data = specialsData as SpecialsFile;
const specials = data.specials ?? [];
const updatedAt = data.updatedAt ?? null;
const hasAny = specials.length > 0;
const board = data.board ?? null;
const credit = data.credit ?? null;

const updatedLabel = updatedAt
  ? new Date(updatedAt).toLocaleDateString('en-US', {
      weekday: 'long',
      month: 'long',
      day: 'numeric',
    })
  : null;

const boardSrc = board ? `/specials-board/${board.key}` : null;
const boardAlt = updatedLabel
  ? `Today's specials board at The Copperline Eatery, photographed ${updatedLabel}`
  : "Today's specials board at The Copperline Eatery";

const creditLine = credit?.name ? (credit.from ? `${credit.name} from ${credit.from}` : credit.name) : null;
---

<div class="specials-content" class:list={[{ 'has-board-photo': hasAny && boardSrc }]}>
  {hasAny ? (
    <>
      {boardSrc && (
        <div class="specials-photo-wrap">
          <img src={boardSrc} alt={boardAlt} loading="lazy" />
        </div>
      )}
      <div class="specials-list">
        {specials.map((s) => (
          <div class="special-item">
            <h4>
              <span>{s.name}</span>
              {s.price && (
                <span class="special-price">
                  {s.price.startsWith('$') ? s.price : `$${s.price}`}
                </span>
              )}
            </h4>
            {s.description && <p>{s.description}</p>}
          </div>
        ))}
        {updatedLabel && <p class="specials-updated">Updated {updatedLabel}</p>}
        {creditLine && (
          <p class="specials-credit">Thank you, {creditLine}, for helping keep our specials board updated!</p>
        )}
      </div>
    </>
  ) : (
    <div class="no-specials">
      <h4>No Specials Today</h4>
      <p>
        Daily specials updated each morning.<br />
        Call us at <a href="tel:+14135948332">(413) 594-8332</a> for today's offerings!
      </p>
    </div>
  )}
</div>
