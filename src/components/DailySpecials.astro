---
import specialsData from '../data/specials.json';

interface Special {
  name: string;
  description: string | null;
  price: string | null;
}

interface Board {
  key: string;
  contentType?: string;
}

interface Credit {
  name: string;
  from?: string;
}

interface SpecialsFile {
  updatedAt?: string | null;
  board?: Board;
  credit?: Credit | null;
  specials?: Special[];
}

interface Props {
  data?: SpecialsFile;
  eager?: boolean;
  headingTag?: 'h2' | 'h3';
}

const { data: dataProp, eager = false, headingTag = 'h3' } = Astro.props as Props;
const Heading = headingTag;
const data = dataProp ?? (specialsData as SpecialsFile);
const specials = data.specials ?? [];
const updatedAt = data.updatedAt ?? null;
const hasAny = specials.length > 0;
const board = data.board ?? null;
const credit = data.credit ?? null;

const updatedLabel = updatedAt
  ? new Date(updatedAt).toLocaleDateString('en-US', {
      weekday: 'long',
      month: 'long',
      day: 'numeric',
    })
  : null;

const cdn = (w: number) => (board ? `/.netlify/images?url=/specials-board/${board.key}&w=${w}&fm=webp&q=75` : null);
const boardAlt = updatedLabel
  ? `Today's specials board at The Copperline Eatery, photographed ${updatedLabel}`
  : "Today's specials board at The Copperline Eatery";

const creditLine = credit?.name ? (credit.from ? `${credit.name} from ${credit.from}` : credit.name) : null;
---

<div class="specials-content" class:list={[{ 'has-board-photo': hasAny && board }]}>
  {hasAny ? (
    <>
      {board && (
        <div class="specials-photo-wrap">
          <img
            src={cdn(800)}
            srcset={`${cdn(480)} 480w, ${cdn(800)} 800w, ${cdn(1200)} 1200w`}
            sizes="(max-width: 899px) 100vw, 380px"
            alt={boardAlt}
            loading={eager ? 'eager' : 'lazy'}
            fetchpriority={eager ? 'high' : undefined}
            decoding="async"
          />
          {updatedLabel && <p class="specials-updated">Updated {updatedLabel}</p>}
          {creditLine && (
            <p class="specials-credit">Thank you, {creditLine}, for helping keep our specials board updated!</p>
          )}
        </div>
      )}
      <div class="specials-list">
        {specials.map((s) => (
          <div class="special-item">
            <Heading class="special-item-title">
              <span>{s.name}</span>
              {s.price && (
                <span class="special-price">
                  {s.price.startsWith('$') ? s.price : `$${s.price}`}
                </span>
              )}
            </Heading>
            {s.description && <p>{s.description}</p>}
          </div>
        ))}
        {!board && updatedLabel && <p class="specials-updated">Updated {updatedLabel}</p>}
        {!board && creditLine && (
          <p class="specials-credit">Thank you, {creditLine}, for helping keep our specials board updated!</p>
        )}
      </div>
    </>
  ) : (
    <div class="no-specials">
      <Heading class="no-specials-title">No Specials Today</Heading>
      <p>
        We post the specials board here most weeks.<br />
        Call us at <a href="tel:+14135948332">(413) 594-8332</a> for today's offerings!
      </p>
    </div>
  )}
</div>
