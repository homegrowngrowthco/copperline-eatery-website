---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ADDRESS, EMAIL, GEO, MAPS_DIRECTIONS_URL, OPENING_HOURS, PHONE, SITE_URL } from '../data/restaurant';

const title = 'Contact & Hours | The Copperline Eatery, Chicopee MA';
const description = 'Visit The Copperline Eatery at 409 Broadway, Chicopee, MA 01020. Open daily from 6am (7am Sunday). Call (413) 594-8332 for questions or catering inquiries.';

const restaurantSchema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: 'The Copperline Eatery',
  url: `${SITE_URL}/contact`,
  image: `${SITE_URL}/logo.jpg`,
  address: ADDRESS,
  geo: GEO,
  telephone: PHONE,
  email: EMAIL,
  openingHoursSpecification: OPENING_HOURS,
  hasMap: MAPS_DIRECTIONS_URL,
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}` },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: `${SITE_URL}/contact` },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${SITE_URL}/contact`}
  ogTitle="Contact & Hours - The Copperline Eatery | Chicopee, MA"
  ogDescription="Visit us at 409 Broadway, Chicopee MA. Open Mon-Fri 6am-2pm, Sat 6am-1:30pm, Sun 7am-1pm. Call (413) 594-8332."
  ogImageAlt="The Copperline Eatery - Contact and Location"
  twitterDescription="Visit us at 409 Broadway, Chicopee MA. Open Mon-Fri 6am-2pm, Sat 6am-1:30pm, Sun 7am-1pm. Call (413) 594-8332."
  schema={[restaurantSchema, breadcrumb]}
>
  <main>
    <section class="page-header">
      <div class="container">
        <h1>Visit Us</h1>
        <p>Hours, Location &amp; Contact Information</p>
      </div>
    </section>

    <section class="contact-section">
      <div class="container">
        <div class="contact-layout">
          <div class="contact-info-hours">
            <h2>Hours</h2>
            <div class="hours-table">
              <div class="hours-row"><span class="day">Monday - Friday</span><span class="time">6:00 AM - 2:00 PM</span></div>
              <div class="hours-row"><span class="day">Saturday</span><span class="time">6:00 AM - 1:30 PM</span></div>
              <div class="hours-row"><span class="day">Sunday</span><span class="time">7:00 AM - 1:00 PM</span></div>
            </div>
          </div>

          <div class="contact-info-address">
            <h2>Address</h2>
            <p class="contact-text">
              <a href={MAPS_DIRECTIONS_URL} target="_blank" rel="noopener" class="contact-link">
                409 Broadway<br />Chicopee, MA 01020
              </a>
            </p>
          </div>

          <div class="contact-info-contact">
            <h2>Contact</h2>
            <p class="contact-text">
              <a href="tel:+14135948332" class="contact-link">(413) 594-8332</a><br />
              <a href={`mailto:${EMAIL}`} class="email-btn">Email Us</a>
            </p>
          </div>

          <div class="contact-map">
            <iframe
              title="Map showing The Copperline Eatery at 409 Broadway, Chicopee, MA"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2973.9384748372843!2d-72.58174868455428!3d42.14692707920006!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89e6e7f7e7f7e7e7%3A0x7e7e7e7e7e7e7e7e!2s409%20Broadway%2C%20Chicopee%2C%20MA%2001020!5e0!3m2!1sen!2sus!4v1234567890123!5m2!1sen!2sus&q=42.146927,-72.579556"
              width="100%"
              height="100%"
              allowfullscreen=""
              loading="lazy"></iframe>
          </div>
        </div>

        <div class="faq-section">
          <h2>Frequently Asked Questions</h2>
          <div class="faq-grid">
            <div class="faq-item">
              <h3>Do you offer takeout and delivery?</h3>
              <p>Yes! Call <a href="tel:+14135948332">(413) 594-8332</a> for takeout or <a href="https://www.doordash.com/store/the-copperline-eatery-chicopee-36368789/81460747" target="_blank" rel="noopener">order on DoorDash</a> for delivery.</p>
            </div>
            <div class="faq-item">
              <h3>Do you take reservations?</h3>
              <p>We operate first-come, first-serve on weekends. For special requests, call <a href="tel:+14135948332">(413) 594-8332</a>.</p>
            </div>
            <div class="faq-item">
              <h3>Vegetarian or gluten-free options?</h3>
              <p>Yes! Let your server know about dietary restrictions and we'll accommodate you.</p>
            </div>
            <div class="faq-item">
              <h3>Is parking available?</h3>
              <p>Yes, free parking in our lot and on-street.</p>
            </div>
            <div class="faq-item">
              <h3>Do you have gift cards?</h3>
              <p>Yes! Call <a href="tel:+14135948332">(413) 594-8332</a> or visit in person.</p>
            </div>
            <div class="faq-item">
              <h3>Do you offer catering?</h3>
              <p>Yes! Visit our <a href="/catering">Catering page</a> or call us for details.</p>
            </div>
          </div>
          <p class="faq-see-all"><a href="/faq">See all 23 frequently asked questions &rarr;</a></p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
