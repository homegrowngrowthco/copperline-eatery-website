---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL } from '../../data/restaurant';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const canonical = `${SITE_URL}/blog/${post.id}`;
const dateLabel = post.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const imageUrl = post.data.image.startsWith('http') ? post.data.image : `${SITE_URL}${post.data.image}`;

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE_URL}/blog` },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  image: imageUrl,
  datePublished: post.data.pubDate.toISOString(),
  author: { '@type': 'Organization', name: 'The Copperline Eatery' },
};
---

<BaseLayout
  title={`${post.data.title} | The Copperline Eatery`}
  description={post.data.description}
  canonical={canonical}
  ogTitle={post.data.title}
  ogDescription={post.data.description}
  ogImage={imageUrl}
  ogImageAlt={post.data.imageAlt}
  schema={[breadcrumb, articleSchema]}
>
  <main>
    <article class="blog-post">
      <!-- Same dark page-header band every other interior page opens with, so the
           post does not drop straight from the sticky nav into the cream body. -->
      <header class="page-header">
        <div class="container blog-post-header">
          <p class="blog-post-date"><a href="/blog">From the Copperline Kitchen</a> &middot; <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{dateLabel}</time></p>
          <h1>{post.data.title}</h1>
        </div>
      </header>

      <section class="content-section">
        <div class="container blog-post-container">
          <div class="blog-post-card">
            <!-- Landscape crop anchored to the top: the available images include tall
                 scanned menus, and rendered at natural height they became a full-screen
                 wall of price lines before the article started. -->
            <img src={post.data.image} alt={post.data.imageAlt} class="blog-post-hero" width="900" height="506" />
            <div class="blog-post-body">
              <Content />
            </div>
            <p class="blog-post-footer">
              <a href="/blog">&larr; Back to the blog</a> &middot; <a href="/menu">View our menu</a> &middot; <a href="/catering/quote">Get a catering quote</a>
            </p>
          </div>
        </div>
      </section>
    </article>
  </main>
</BaseLayout>

<style>
  .blog-post-header {
    max-width: 900px;
  }
  .blog-post .page-header h1 {
    font-size: 2.1rem;
    margin-bottom: 0;
  }
  .blog-post-date {
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    opacity: 0.85;
    margin-bottom: 10px;
  }
  .blog-post-date a {
    color: inherit;
    border-bottom: 1px solid rgba(255, 255, 255, 0.5);
  }
  .blog-post-date a:hover {
    color: var(--white);
    border-bottom-color: var(--white);
  }
  .blog-post-container {
    max-width: 800px;
  }
  .blog-post-card {
    background: var(--white);
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    padding: 32px;
  }
  .blog-post-hero {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top;
    border-radius: 6px;
    margin: 0 0 28px;
  }
  .blog-post-body {
    font-size: 1.05rem;
    line-height: 1.8;
  }
  .blog-post-body :global(p),
  .blog-post-body :global(li) {
    color: var(--black);
  }
  .blog-post-body :global(h2) {
    font-size: 1.5rem;
    margin-top: 1.6em;
    margin-bottom: 0.5em;
    color: var(--green-dark);
  }
  .blog-post-body :global(h3) {
    font-size: 1.2rem;
    margin-top: 1.4em;
    margin-bottom: 0.4em;
    color: var(--green-dark);
  }
  .blog-post-body :global(p) {
    margin-bottom: 1.25em;
  }
  .blog-post-body :global(ul),
  .blog-post-body :global(ol) {
    margin-bottom: 1.25em;
    padding-left: 1.4em;
  }
  .blog-post-body :global(li) {
    margin-bottom: 0.4em;
  }
  .blog-post-body :global(a) {
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .blog-post-footer {
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid #e5e5e5;
    text-align: center;
    font-size: 0.95rem;
  }
  @media (max-width: 640px) {
    .blog-post .page-header h1 {
      font-size: 1.5rem;
    }
    .blog-post-card {
      padding: 18px;
      border-radius: 6px;
    }
    .blog-post-hero {
      margin-bottom: 20px;
    }
    .blog-post-body {
      font-size: 1rem;
    }
  }
</style>
