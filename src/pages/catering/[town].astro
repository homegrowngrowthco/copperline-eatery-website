---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CateringPackages from '../../components/CateringPackages.astro';
import { ADDRESS, EMAIL, PHONE, PHONE_DISPLAY, SITE_URL } from '../../data/restaurant';
import { SERVICE_AREAS, type ServiceArea } from '../../data/serviceAreas';

export function getStaticPaths() {
  return SERVICE_AREAS.map((area) => ({ params: { town: area.slug }, props: { area } }));
}

interface Props {
  area: ServiceArea;
}

const { area } = Astro.props;
const pageUrl = `${SITE_URL}/catering/${area.slug}`;

const title = `Catering in ${area.town}, MA - Breakfast & Lunch Delivered | The Copperline Eatery`;
const description = `Breakfast, lunch & dinner catering delivered to ${area.town}, MA from The Copperline Eatery in Chicopee, about ${area.driveMin} minutes away. Buffet packages from $13.95 per person. Corporate events, showers, graduations, parties. Call (413) 594-8332.`;

const areaServed = [
  { '@type': 'City', name: area.town },
  ...(area.neighborhoods || []).map((n) => ({ '@type': 'Place', name: `${n}, ${area.town} MA` })),
];

const cateringSchema = {
  '@context': 'https://schema.org',
  '@type': 'FoodEstablishment',
  name: 'The Copperline Eatery',
  url: pageUrl,
  image: `${SITE_URL}/catering-breakfast.jpg`,
  description: `Breakfast, lunch, and dinner catering delivered to ${area.town}, Massachusetts from The Copperline Eatery in Chicopee. Buffet packages from $13.95 per person.`,
  servesCuisine: ['American', 'Breakfast', 'Lunch', 'Dinner'],
  address: ADDRESS,
  telephone: PHONE,
  email: EMAIL,
  priceRange: '$$',
  areaServed,
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}` },
    { '@type': 'ListItem', position: 2, name: 'Catering', item: `${SITE_URL}/catering` },
    { '@type': 'ListItem', position: 3, name: `${area.town}, MA`, item: pageUrl },
  ],
};

// Nearby towns for cross-links (closest 4 by straight-line distance).
const nearby = SERVICE_AREAS.filter((a) => a.slug !== area.slug)
  .map((a) => ({ a, d: Math.hypot(a.lat - area.lat, a.lng - area.lng) }))
  .sort((x, y) => x.d - y.d)
  .slice(0, 4)
  .map((x) => x.a);
---

<BaseLayout
  title={title}
  description={description}
  canonical={pageUrl}
  ogTitle={`Catering in ${area.town}, MA | The Copperline Eatery`}
  ogDescription={`Breakfast & lunch catering delivered to ${area.town} from Chicopee, about ${area.driveMin} minutes away. Buffet packages from $13.95/person. Call (413) 594-8332.`}
  ogImage={`${SITE_URL}/catering-breakfast.jpg`}
  ogImageAlt="Breakfast catering from The Copperline Eatery - eggs, bacon, and toast"
  twitterTitle={`Catering in ${area.town}, MA | The Copperline Eatery`}
  twitterDescription={`Breakfast & lunch catering delivered to ${area.town}, MA. Buffet packages from $13.95/person. Call (413) 594-8332.`}
  schema={[cateringSchema, breadcrumb]}
>
  <main>
    <section class="page-header">
      <div class="container">
        <h1>Catering in {area.town}, MA</h1>
        <p>Breakfast &amp; lunch catering delivered from The Copperline Eatery in Chicopee</p>
      </div>
    </section>

    <section class="content-section">
      <div class="container">
        <div class="catering-content">
          <p class="lead catering-lead">The Copperline Eatery caters breakfast, lunch, and dinner for events in {area.town}, Massachusetts. Our kitchen at 409 Broadway in Chicopee is roughly a {area.driveMin}-minute drive away, so hot buffets arrive hot. Choose on-site service, drop-off, or pick up your order from the restaurant.</p>

          <p class="catering-town-local">{area.local}</p>
          {area.neighborhoods && (
            <p class="catering-town-local">We serve all of {area.town}, including {area.neighborhoods.join(', ')}.</p>
          )}

          <div class="catering-cta-row">
            <a href="/catering#catering-inquiry" class="btn btn-primary">Request a Catering Quote</a>
            <a href="tel:+14135948332" class="btn btn-secondary">Call {PHONE_DISPLAY}</a>
          </div>

          <h2 class="catering-events-title">Packages &amp; Pricing</h2>
          <CateringPackages />

          <h2 class="catering-events-title">Events We Cater in {area.town}</h2>
          <div class="catering-options">
            <div class="catering-option-card">
              <h3>Corporate &amp; Business</h3>
              <ul>
                <li>Office Meetings &amp; Lunches</li>
                <li>Corporate Retreats &amp; Trainings</li>
                <li>Networking Events</li>
                <li>Employee Appreciation</li>
              </ul>
            </div>
            <div class="catering-option-card">
              <h3>Celebrations</h3>
              <ul>
                <li>Weddings &amp; Rehearsals</li>
                <li>Bridal &amp; Baby Showers</li>
                <li>Graduations &amp; Birthdays</li>
                <li>Family Reunions &amp; Holiday Parties</li>
              </ul>
            </div>
            <div class="catering-option-card">
              <h3>Community</h3>
              <ul>
                <li>Church Socials &amp; School Functions</li>
                <li>Banquets &amp; Fundraisers</li>
                <li>Memorial Services</li>
                <li>Sporting Events &amp; Tailgates</li>
              </ul>
            </div>
          </div>

          <div class="cta-box">
            <h3>Planning an Event in {area.town}?</h3>
            <p>Call us at <a href="tel:+14135948332" class="highlight-link">{PHONE_DISPLAY}</a> or <a href="/catering#catering-inquiry" class="highlight-link">send a catering inquiry</a>.</p>
            <p class="cta-box-note">Family-owned in Chicopee since 1993 &middot; Voted Best Breakfast in Western Massachusetts</p>
          </div>

          <p class="catering-nearby">Also catering nearby: {nearby.map((n, i) => (
            <>{i > 0 && ' · '}<a href={`/catering/${n.slug}`}>{n.town}</a></>
          ))} &nbsp;&middot;&nbsp; <a href="/catering">All service areas</a></p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
