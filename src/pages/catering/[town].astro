---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CateringMenus from '../../components/CateringMenus.astro';
import { ADDRESS, EMAIL, PHONE, PHONE_DISPLAY, SITE_URL } from '../../data/restaurant';
import { SERVICE_AREAS, type ServiceArea } from '../../data/serviceAreas';

export function getStaticPaths() {
  return SERVICE_AREAS.map((area) => ({ params: { town: area.slug }, props: { area } }));
}

interface Props {
  area: ServiceArea;
}

const { area } = Astro.props;
const pageUrl = `${SITE_URL}/catering/${area.slug}`;

const title = `Catering in ${area.town}, MA | The Copperline Eatery`;
const description = `Breakfast, lunch & dinner catering delivered to ${area.town}, MA from The Copperline Eatery in Chicopee, about ${area.driveMin} minutes away. Custom menus for corporate events, showers, graduations, and parties. Call (413) 594-8332.`;

const areaServed = [
  { '@type': 'City', name: area.town },
  ...(area.neighborhoods || []).map((n) => ({ '@type': 'Place', name: `${n}, ${area.town} MA` })),
];

const cateringSchema = {
  '@context': 'https://schema.org',
  '@type': 'FoodEstablishment',
  name: 'The Copperline Eatery',
  url: pageUrl,
  image: `${SITE_URL}/catering-breakfast.jpg`,
  description: `Breakfast, lunch, and dinner catering delivered to ${area.town}, Massachusetts from The Copperline Eatery in Chicopee, with a custom menu built for every event.`,
  servesCuisine: ['American', 'Breakfast', 'Lunch', 'Dinner'],
  address: ADDRESS,
  telephone: PHONE,
  email: EMAIL,
  priceRange: '$$',
  areaServed,
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}` },
    { '@type': 'ListItem', position: 2, name: 'Catering', item: `${SITE_URL}/catering` },
    { '@type': 'ListItem', position: 3, name: `${area.town}, MA`, item: pageUrl },
  ],
};

// Nearby towns for cross-links (closest 4 by straight-line distance).
const nearby = SERVICE_AREAS.filter((a) => a.slug !== area.slug)
  .map((a) => ({ a, d: Math.hypot(a.lat - area.lat, a.lng - area.lng) }))
  .sort((x, y) => x.d - y.d)
  .slice(0, 4)
  .map((x) => x.a);

const portrait = area.photo.h > area.photo.w;

function andJoin(items: readonly string[]): string {
  if (items.length <= 1) return items[0] ?? '';
  return items.slice(0, -1).join(', ') + ' and ' + items[items.length - 1];
}
---

<BaseLayout
  title={title}
  description={description}
  canonical={pageUrl}
  ogTitle={`Catering in ${area.town}, MA | The Copperline Eatery`}
  ogDescription={`Breakfast & lunch catering delivered to ${area.town} from Chicopee, about ${area.driveMin} minutes away. Custom menus for every event. Call (413) 594-8332.`}
  ogImage={`${SITE_URL}/catering-breakfast.jpg`}
  ogImageAlt="Breakfast catering from The Copperline Eatery - eggs, bacon, and toast"
  twitterTitle={`Catering in ${area.town}, MA | The Copperline Eatery`}
  twitterDescription={`Breakfast & lunch catering delivered to ${area.town}, MA. Custom menus for every event. Call (413) 594-8332.`}
  schema={[cateringSchema, breadcrumb]}
>
  <main>
    <section class="page-header">
      <div class="container">
        <h1>Catering in {area.town}, MA</h1>
        <p>Breakfast &amp; lunch delivered from The Copperline Eatery in Chicopee</p>
      </div>
    </section>

    <section class="content-section">
      <div class="container">
        <div class="catering-content">

          <div class="town-hero">
            <div class="town-hero-text">
              <p class="town-intro">{area.intro}</p>
              <div class="town-facts">
                <div class="town-fact">
                  <span class="town-fact-label">Drive from our kitchen</span>
                  <span class="town-fact-value">~{area.driveMin} min</span>
                </div>
                <div class="town-fact">
                  <span class="town-fact-label">Google rating</span>
                  <span class="town-fact-value">4.5&#9733;<span class="town-fact-unit"> 1,100+ reviews</span></span>
                </div>
                <div class="town-fact">
                  <span class="town-fact-label">Service</span>
                  <span class="town-fact-value town-fact-value--small">On-site &middot; Drop-off &middot; Pick-up</span>
                </div>
              </div>
              <div class="catering-cta-row town-cta-row">
                <a href="/catering#catering-inquiry" class="btn btn-primary">Request a Quote</a>
                <a href="tel:+14135948332" class="btn btn-secondary">Call {PHONE_DISPLAY}</a>
              </div>
            </div>
            <figure class={`town-photo${portrait ? ' town-photo--portrait' : ''}`}>
              <picture>
                <source srcset={`${area.photo.base}.webp`} type="image/webp" />
                <img src={`${area.photo.base}.jpg`} alt={area.photo.alt} width={area.photo.w} height={area.photo.h} loading="eager" />
              </picture>
              <figcaption class="town-photo-credit">
                Photo: <a href={area.photo.creditUrl} target="_blank" rel="noopener">{area.photo.creditArtist}</a>, {area.photo.creditLicense}, via Wikimedia Commons
              </figcaption>
            </figure>
          </div>

          <h2 class="catering-events-title">Around {area.town}</h2>
          <p class="town-around">{area.aroundTown}</p>
          <ul class="town-venues">
            {area.venues.map((v) => (
              <li><a href={v.url} target="_blank" rel="noopener">{v.name}</a></li>
            ))}
          </ul>
          {area.neighborhoods && (
            <p class="town-around">We serve all of {area.town}, including {andJoin(area.neighborhoods)}.</p>
          )}

          <h2 class="catering-events-title">What We Cater</h2>
          <CateringMenus />

          <h2 class="catering-events-title">Events We Cater in {area.town}</h2>
          <div class="catering-options">
            <div class="catering-option-card">
              <h3>Corporate &amp; Business</h3>
              <ul>
                <li>Office Meetings &amp; Lunches</li>
                <li>Corporate Retreats &amp; Trainings</li>
                <li>Networking Events</li>
                <li>Employee Appreciation</li>
              </ul>
            </div>
            <div class="catering-option-card">
              <h3>Celebrations</h3>
              <ul>
                <li>Weddings &amp; Rehearsals</li>
                <li>Bridal &amp; Baby Showers</li>
                <li>Graduations &amp; Birthdays</li>
                <li>Family Reunions &amp; Holiday Parties</li>
              </ul>
            </div>
            <div class="catering-option-card">
              <h3>Community</h3>
              <ul>
                <li>Church Socials &amp; School Functions</li>
                <li>Banquets &amp; Fundraisers</li>
                <li>Memorial Services</li>
                <li>Sporting Events &amp; Tailgates</li>
              </ul>
            </div>
          </div>

          <div class="cta-box">
            <h3>Planning an Event in {area.town}?</h3>
            <p>Call us at <a href="tel:+14135948332" class="highlight-link">{PHONE_DISPLAY}</a> or <a href="/catering#catering-inquiry" class="highlight-link">send a catering inquiry</a>.</p>
            <p class="cta-box-note">Family-owned in Chicopee since 1993 &middot; Voted Best Breakfast in Western Massachusetts</p>
          </div>

          <div class="town-nearby">
            <span class="town-nearby-label">Also catering nearby:</span>
            <div class="town-pills">
              {nearby.map((n) => (
                <a class="town-pill" href={`/catering/${n.slug}`}>{n.town}</a>
              ))}
              <a class="town-pill town-pill--all" href="/catering">All service areas</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
