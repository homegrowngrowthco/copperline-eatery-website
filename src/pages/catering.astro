---
import BaseLayout from '../layouts/BaseLayout.astro';
import CateringMenus from '../components/CateringMenus.astro';
import { ADDRESS, AREA_SERVED, EMAIL, PHONE, PHONE_DISPLAY, SITE_URL } from '../data/restaurant';
import { SERVICE_AREAS } from '../data/serviceAreas';

const title = 'Catering in Chicopee & Western Mass | The Copperline Eatery';
const description = 'Breakfast, lunch & dinner catering from Chicopee, MA across Western Mass and northern CT. Custom menus for corporate events, weddings & parties. (413) 594-8332.';

const cateringSchema = {
  '@context': 'https://schema.org',
  '@type': 'FoodEstablishment',
  name: 'The Copperline Eatery',
  url: `${SITE_URL}/catering`,
  image: `${SITE_URL}/catering-breakfast.jpg`,
  description:
    'Professional catering services for Western Massachusetts and northern Connecticut - breakfast, lunch, and dinner catering for corporate events, weddings, parties, and special occasions, with a custom menu built for every event.',
  servesCuisine: ['American', 'Breakfast', 'Lunch', 'Dinner'],
  address: ADDRESS,
  telephone: PHONE,
  email: EMAIL,
  priceRange: '$$',
  areaServed: AREA_SERVED,
  hasMenu: `${SITE_URL}/menu`,
};

// The catering FAQs, mirrored from /faq so this page carries its own FAQPage
// rich-result eligibility for catering queries. This array is the single
// source for both the visible "Catering Questions" section below and the
// JSON-LD mainEntity, so the two cannot drift apart (AUDIT-SEO-2026-09-24.md
// section 6, fix 5: Google's FAQ guidance requires the questions in a
// FAQPage schema to actually be visible on the page). The last four entries
// are the People Also Ask questions the audit found on the catering SERPs
// ("breakfast catering near me", "catering chicopee ma"), added 2026-09-24.
interface CateringFaq {
  question: string;
  answer: string;
}

const cateringFaqs: CateringFaq[] = [
  { question: 'What kind of food does The Copperline Eatery cater?', answer: 'Breakfast and brunch spreads (eggs, bacon and sausage, home fries, French toast, pancakes), lunch platters (cold cuts, sandwiches, wraps, salads), and hot dinner buffets (roasted chicken in 15+ preparations, ziti and meatballs, lasagna, roast turkey, baked scrod). Every menu is customized to your event; contact us for a quote.' },
  { question: 'What areas does The Copperline Eatery cater?', answer: 'We cater across Western Massachusetts and northern Connecticut from our Chicopee kitchen, including Springfield, Holyoke, West Springfield, Agawam, Westfield, Ludlow, South Hadley, Longmeadow, East Longmeadow, Wilbraham, Northampton, Amherst, Enfield, Suffield, Windsor Locks, Somers, and the surrounding Hampden, Hampshire, Hartford, and Tolland County towns.' },
  { question: 'What service options are available?', answer: 'On-site service, drop-off, or pick-up at our restaurant at 409 Broadway, Chicopee. We serve buffet style, to-go buffet style, or individual portions, and we can build a custom menu for your event.' },
  { question: 'How far in advance should I book catering?', answer: 'For most events we recommend booking at least one to two weeks in advance. Larger events and weekend dates should be booked three to four weeks ahead when possible. Call (413) 594-8332 to check availability.' },
  { question: 'What types of events does The Copperline Eatery cater?', answer: 'Corporate meetings and office lunches, weddings and rehearsal dinners, bridal and baby showers, graduations, birthdays, family reunions, holiday parties, church socials, school functions, banquets, fundraisers, sporting events and tailgates, memorial services, film and photo shoots, and healthcare facilities.' },
  { question: 'How much does breakfast catering cost?', answer: 'Every menu is built for the event, so we quote per person once we know your headcount, the menu, and whether it is drop-off, pick-up, or served on site. You can build an itemized estimate in about a minute with our online quote builder at copperlineeatery.com/catering/quote, or call (413) 594-8332 and we will price it with you.' },
  { question: 'How much food should I order for 20 people?', answer: 'Tell us the headcount and we size the order for you; that is part of every quote. For a rough idea before you call, our post on how much breakfast catering to order for 25, 50, or 100 people walks through it.' },
  { question: 'Who does breakfast catering near Chicopee and Springfield?', answer: 'We do, from our kitchen at 409 Broadway in Chicopee. MassLive readers voted The Copperline Eatery Best Breakfast in Western Massachusetts, and we cater breakfast and brunch spreads across Hampden County, including Springfield, Holyoke, West Springfield, Agawam, and Westfield, plus northern Connecticut.' },
  { question: 'Do you cater corporate breakfasts and office lunches?', answer: 'Yes. Corporate meetings and office lunches are among the events we cater most, with buffet, to-go buffet, or individual portions, delivered or picked up. Contact us with the date, headcount, and start time for a quote.' },
];

const cateringFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: cateringFaqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}` },
    { '@type': 'ListItem', position: 2, name: 'Catering', item: `${SITE_URL}/catering` },
  ],
};

const hampden = SERVICE_AREAS.filter((a) => a.county === 'Hampden County');
const hampshire = SERVICE_AREAS.filter((a) => a.county === 'Hampshire County');
const connecticut = SERVICE_AREAS.filter((a) => a.state === 'CT');
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${SITE_URL}/catering`}
  ogTitle="Catering in Chicopee, MA - Breakfast & Lunch Catering for Western Massachusetts"
  ogDescription="Custom menus for corporate events, weddings, showers, and parties across Springfield, Holyoke & Western MA. On-site, drop-off, or pick-up. Call (413) 594-8332."
  ogImage={`${SITE_URL}/catering-breakfast.jpg`}
  ogImageAlt="Breakfast catering from The Copperline Eatery - eggs, bacon, and toast"
  twitterTitle="Catering in Chicopee, MA | The Copperline Eatery"
  twitterDescription="Breakfast & lunch catering across Western MA with a custom menu for every event. Call (413) 594-8332."
  schema={[cateringSchema, cateringFaqSchema, breadcrumb]}
>
  <main>
    <section class="page-header">
      <div class="container">
        <h1>Catering in Chicopee, MA &amp; Western Massachusetts</h1>
        <p>Breakfast, lunch &amp; dinner catering from the team voted Best Breakfast in Western MA</p>
      </div>
    </section>

    <section class="content-section">
      <div class="container">
        <div class="catering-content">
          <div class="catering-cta-row">
            <a href="/catering/quote" class="btn btn-primary">Build Your Catering Quote</a>
            <a href="/catering-menu.pdf" download class="btn btn-secondary">Download Catering Menu</a>
          </div>

          <p class="lead catering-lead">We cater across Western Massachusetts and northern Connecticut: served on-site, dropped off hot, or ready for pick-up in Chicopee.</p>

          <h2 class="catering-events-title">Where We Cater</h2>
          <p class="catering-events-intro">We deliver throughout the Pioneer Valley and into northern Connecticut. Pick your town for details:</p>

          <div class="service-area-block">
            <h3 class="service-area-county">Hampden County</h3>
            <div class="town-pills">
              {hampden.map((a) => (
                <a class="town-pill" href={`/catering/${a.slug}`}>{a.town}</a>
              ))}
            </div>
            <h3 class="service-area-county">Hampshire County</h3>
            <div class="town-pills">
              {hampshire.map((a) => (
                <a class="town-pill" href={`/catering/${a.slug}`}>{a.town}</a>
              ))}
              <a class="town-pill town-pill--all" href="/catering/western-massachusetts">All of Western Massachusetts</a>
            </div>
            <h3 class="service-area-county">Northern Connecticut</h3>
            <div class="town-pills">
              {connecticut.map((a) => (
                <a class="town-pill" href={`/catering/${a.slug}`}>{a.town}</a>
              ))}
            </div>
          </div>

          <h2 class="catering-events-title">What We Cater</h2>
          <CateringMenus />

          <h2 class="catering-events-title">How It Works</h2>
          <div class="how-it-works">
            <div class="how-step">
              <div class="how-step-head">
                <span class="how-step-num">1</span>
                <h3>Tell us about your event</h3>
              </div>
              <p><a href="/catering/quote">Build a quote online</a> or call <a href="tel:+14135948332">(413) 594-8332</a> with your date, headcount, and the occasion.</p>
            </div>
            <div class="how-step">
              <div class="how-step-head">
                <span class="how-step-num">2</span>
                <h3>We build your menu</h3>
              </div>
              <p>Breakfast, lunch, dinner, or a mix, served buffet style, to-go, or as individual portions. We'll quote it for your headcount.</p>
            </div>
            <div class="how-step">
              <div class="how-step-head">
                <span class="how-step-num">3</span>
                <h3>We handle the food</h3>
              </div>
              <p>On-site service, hot drop-off at your venue, or pick-up at the restaurant, whatever fits your event.</p>
            </div>
          </div>

          <h2 class="catering-events-title">Events We've Catered</h2>
          <p class="catering-events-intro">From intimate gatherings to large corporate events, here's what we cater:</p>

          <div class="catering-options">
            <div class="catering-option-card">
              <h3>Corporate &amp; Business</h3>
              <ul>
                <li>Office Meetings &amp; Lunches</li>
                <li>Corporate Retreats</li>
                <li>Networking Events</li>
                <li>Grand Openings</li>
                <li>Employee Appreciation</li>
              </ul>
            </div>

            <div class="catering-option-card">
              <h3>Celebrations</h3>
              <ul>
                <li>Weddings &amp; Rehearsals</li>
                <li>Bridal &amp; Jack &amp; Jill Showers</li>
                <li>Graduations</li>
                <li>Birthdays</li>
                <li>Family Reunions</li>
                <li>Holiday Parties</li>
              </ul>
            </div>

            <div class="catering-option-card">
              <h3>Community &amp; Special Events</h3>
              <ul>
                <li>Church Socials</li>
                <li>School Functions</li>
                <li>Banquets &amp; Fundraisers</li>
                <li>Sporting Events &amp; Tailgates</li>
                <li>Memorial Services</li>
                <li>Film &amp; Photo Shoots</li>
                <li>Healthcare Facilities</li>
              </ul>
            </div>
          </div>

          <h2 class="catering-events-title">Catering Questions</h2>
          <section class="faq-group" id="catering-questions">
            {cateringFaqs.map((f) => (
              <details class="faq-q">
                <summary>{f.question}</summary>
                <div class="faq-a">
                  {f.question === 'How much food should I order for 20 people?' ? (
                    <p>Tell us the headcount and we size the order for you; that is part of every quote. For a rough idea before you call, our post on <a href="/blog/breakfast-catering-quantities">how much breakfast catering to order for 25, 50, or 100 people</a> walks through it.</p>
                  ) : (
                    <p>{f.answer}</p>
                  )}
                </div>
              </details>
            ))}
          </section>

          <div id="catering-inquiry" class="catering-form-block">
            <h2>Or Just Send Us a Note</h2>
            <p>Not sure what you want yet? Tell us about your event and we'll take it from there, usually within one business day. If you'd rather pick a buffet and see pricing as you go, <a href="/catering/quote" class="highlight-link">build a quote online</a>. Prefer to talk it through? Call <a href="tel:+14135948332" class="highlight-link">{PHONE_DISPLAY}</a>.</p>
            <form name="catering-inquiry" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/catering-thanks" class="catering-form">
              <input type="hidden" name="form-name" value="catering-inquiry" />
              <p class="hidden-field" aria-hidden="true">
                <label>Don't fill this out if you're human: <input name="bot-field" /></label>
              </p>
              <div class="form-row">
                <div class="form-field">
                  <label for="ci-name">Your name *</label>
                  <input id="ci-name" name="name" type="text" required autocomplete="name" />
                </div>
                <div class="form-field">
                  <label for="ci-phone">Phone *</label>
                  <input id="ci-phone" name="phone" type="tel" required autocomplete="tel" />
                </div>
              </div>
              <div class="form-row">
                <div class="form-field">
                  <label for="ci-email">Email</label>
                  <input id="ci-email" name="email" type="email" autocomplete="email" />
                </div>
                <div class="form-field">
                  <label for="ci-date">Event date</label>
                  <input id="ci-date" name="event-date" type="date" />
                </div>
              </div>
              <div class="form-row">
                <div class="form-field">
                  <label for="ci-guests">Approximate guest count</label>
                  <input id="ci-guests" name="guest-count" type="number" min="1" inputmode="numeric" />
                </div>
                <div class="form-field">
                  <label for="ci-type">Event type</label>
                  <select id="ci-type" name="event-type">
                    <option value="">Choose one (optional)</option>
                    <option>Corporate / office</option>
                    <option>Wedding / rehearsal</option>
                    <option>Shower / graduation / birthday</option>
                    <option>Holiday party</option>
                    <option>Memorial service</option>
                    <option>Church / school / community</option>
                    <option>Other</option>
                  </select>
                </div>
              </div>
              <div class="form-field">
                <label for="ci-town">Event town/city</label>
                <input id="ci-town" name="event-town" type="text" placeholder="e.g. Springfield, MA" />
              </div>
              <div class="form-field">
                <label for="ci-notes">Tell us about your event</label>
                <textarea id="ci-notes" name="notes" rows="4" placeholder="Breakfast or lunch? On-site, drop-off, or pick-up? Anything else we should know?"></textarea>
              </div>
              <button type="submit" class="btn btn-primary catering-form-submit">Send Inquiry</button>
            </form>
          </div>

          <div class="cta-box">
            <h3>Ready to Cater Your Event?</h3>
            <p>Call us at <a href="tel:+14135948332" class="highlight-link">{PHONE_DISPLAY}</a></p>
            <p>Email us at <a href={`mailto:${EMAIL}`} class="highlight-link">{EMAIL}</a></p>
            <p class="cta-box-note">Serving Chicopee, Springfield, Holyoke, all of Western Massachusetts, and northern Connecticut</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
