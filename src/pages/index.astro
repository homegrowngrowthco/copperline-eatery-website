---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  ADDRESS,
  AGGREGATE_RATING,
  AREA_SERVED,
  AWARDS,
  CURRENCIES_ACCEPTED,
  DOORDASH_URL,
  EMAIL,
  GEO,
  OPENING_HOURS,
  PAYMENT_ACCEPTED,
  PHONE,
  SAME_AS,
  SITE_URL,
} from '../data/restaurant';

const title = 'The Copperline Eatery - Best Breakfast & Lunch in Western Massachusetts | Chicopee, Springfield, Holyoke';
const description = 'Family-owned Chicopee restaurant since 1993, serving brunch classics like eggs benedict, homemade corned beef hash, and banana bread French toast. Voted Best Breakfast in Western MA. Catering available across Springfield, Holyoke, and Hampden County.';

const restaurantSchema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: 'The Copperline Eatery',
  image: `${SITE_URL}/logo.jpg`,
  description: 'Family-owned Chicopee restaurant since 1993, voted Best Breakfast in Western Massachusetts. Brunch classics including eggs benedict, homemade corned beef hash, and banana bread French toast. Catering available.',
  address: ADDRESS,
  geo: GEO,
  telephone: PHONE,
  email: EMAIL,
  url: SITE_URL,
  servesCuisine: ['American', 'Breakfast', 'Brunch', 'Lunch'],
  priceRange: '$$',
  paymentAccepted: PAYMENT_ACCEPTED,
  currenciesAccepted: CURRENCIES_ACCEPTED,
  acceptsReservations: false,
  hasMenu: `${SITE_URL}/menu`,
  openingHoursSpecification: OPENING_HOURS,
  aggregateRating: AGGREGATE_RATING,
  review: [
    { '@type': 'Review', author: { '@type': 'Person', name: 'Robert S.' }, reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' }, reviewBody: "Top three best eggs Benedict places I've been to. I've had eggs Benedict from here to California, Maine to Florida and in between. There is good eggs Benedict and there is great eggs Benedict." },
    { '@type': 'Review', author: { '@type': 'Person', name: 'Cyrus D.' }, reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' }, reviewBody: "It's friendly, it's lively, it's spirited, the vibe is IMMACULATE. The poached egg my mother ordered was perfectly prepared, ideal consistency. Her pancakes were fluffy and hearty." },
    { '@type': 'Review', author: { '@type': 'Person', name: 'Lori G.' }, reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' }, reviewBody: 'I had the eggs Benedict which was delicious. The hollandaise was perfect — not too much lemon. The home fries were cooked and seasoned perfectly. I wish I lived here so I could go anytime!' },
    { '@type': 'Review', author: { '@type': 'Person', name: 'Teresa D.' }, reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' }, reviewBody: "I had my favorite, eggs benedict and that Hollandaise sauce was out of this world delicious! The best I've ever had. Even though we weren't locals we fit right in and felt treated like a local by the awesome staff." },
    { '@type': 'Review', author: { '@type': 'Person', name: 'Steve P.' }, reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' }, reviewBody: 'Great Mass Hash. Big portion of hash with 2 over easy eggs on top. The server was very friendly and super fast. The rye toast and breakfast sausage were also very good. Lots of locals here — that speaks volumes to the quality.' },
  ],
  areaServed: AREA_SERVED,
  knowsAbout: ['eggs benedict', 'corned beef hash', 'hollandaise sauce', 'French toast', 'homemade breakfast', 'family restaurant', 'catering', 'best French toast Western Massachusetts'],
  award: AWARDS,
  sameAs: SAME_AS,
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'The Copperline Eatery',
  url: SITE_URL,
  description: 'Official website of The Copperline Eatery, family-owned in Chicopee since 1993.',
  publisher: {
    '@type': 'Restaurant',
    name: 'The Copperline Eatery',
    telephone: PHONE,
    address: ADDRESS,
  },
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${SITE_URL}`}
  ogTitle="The Copperline Eatery - Best Breakfast in Western MA"
  ogDescription="Family-owned Chicopee restaurant since 1993. Voted Best Breakfast in Western MA. Brunch classics like eggs benedict, corned beef hash, and banana bread French toast. Catering available."
  schema={[restaurantSchema, websiteSchema]}
>
  <main>
    <section class="hero-section">
      <div class="hero">
        <h1 class="hero-title">Best Breakfast &amp; Lunch in Western MA!</h1>
        <p class="hero-subtitle">Serving Chicopee &amp; Hampden County for 33+ years</p>
      </div>
    </section>

    <section class="home-content">
      <div class="container">
        <div class="cta-buttons">
          <a href="/menu" class="btn btn-secondary">View Our Menu</a>
          <a href="/menu#specials" class="btn btn-accent">Today's Specials</a>
          <a href={DOORDASH_URL} target="_blank" rel="noopener" class="btn btn-primary">DoorDash</a>
        </div>

        <div class="home-grid">
          <div class="info-column">
            <div class="info-card-stacked">
              <div class="info-icon">&#128197;</div>
              <div>
                <h2 class="info-card-heading">Open 7 Days a Week</h2>
                <p>Mon-Fri: 6:00am-2:00pm<br />Saturday: 6:00am-1:30pm<br />Sunday: 6:30am-1:00pm</p>
              </div>
            </div>
            <div class="info-card-stacked">
              <div class="info-icon">&#128222;</div>
              <div>
                <h2 class="info-card-heading">Takeout or Delivery</h2>
                <p><a href="tel:+14135948332">(413) 594-8332</a> for takeout<br />
                <a href={DOORDASH_URL} target="_blank" rel="noopener">DoorDash</a> for delivery</p>
              </div>
            </div>
            <div class="info-card-stacked">
              <div class="info-icon">&#11088;</div>
              <div>
                <h2 class="info-card-heading">Daily Specials</h2>
                <p><a href="/menu#specials">View today's specials</a></p>
              </div>
            </div>
            <div class="info-card-stacked">
              <div class="info-icon">&#127869;&#65039;</div>
              <div>
                <h2 class="info-card-heading">Catering Services</h2>
                <p><a href="/catering">View our catering menu &amp; order form</a></p>
              </div>
            </div>
          </div>

          <div class="reviews-column">
            <h2>What Our Customers Say</h2>
            <div class="reviews-carousel-home" id="reviewsCarousel">
              <button class="carousel-btn prev" id="prevReview" aria-label="Previous review">&lsaquo;</button>
              <div class="reviews-wrapper">
                <div class="review-slide active">
                  <div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                  <p class="review-text">"Top three best egg Benedict places I've been too. I've had eggs Benedict from here to California, Maine to Florida and in between. There is good eggs Benedict and there is great eggs Benedict."</p>
                  <p class="review-author">- Robert S., Google Review</p>
                </div>
                <div class="review-slide">
                  <div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                  <p class="review-text">"Before I even got my food, I just NEEDED to say right away: it's friendly, it's lively, it's spirited, the vibe is &#10024; IMMACULATE&#10024;. And the food itself was even more so! The poached egg my mother ordered was perfectly prepared, ideal consistency. Her pancakes were fluffy and hearty."</p>
                  <p class="review-author">- Cyrus D., Google Review</p>
                </div>
                <div class="review-slide">
                  <div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                  <p class="review-text">"Stopped by here for breakfast on recommendation from a friend. We were not disappointed. I had the eggs Benedict which was delicious. The hollandaise was perfect...not too much lemon. The home fries were cooked and seasoned perfectly. I wish I lived here so I could go anytime!"</p>
                  <p class="review-author">- Lori G., Google Review</p>
                </div>
                <div class="review-slide">
                  <div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                  <p class="review-text">"My friend and I were looking for breakfast and we were in the area OMG so happy we chose to eat here! Even though we weren't locals we fit right in and felt treated like a local by the awesome staff. I had my favorite, eggs benedict and that Hollandaise sauce was out of this world delicious! The best I've ever had."</p>
                  <p class="review-author">- Teresa D., Google Review</p>
                </div>
                <div class="review-slide">
                  <div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                  <p class="review-text">"The reason I go here every morning for Breakfast is....excellent food, excellent service, and you always leave there with a smile on you face."</p>
                  <p class="review-author">- John, Google Review</p>
                </div>
                <div class="review-slide">
                  <div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                  <p class="review-text">"Great Mass Hash. Big portion of hash with 2 over easy eggs on top. The server / chef was very friendly and super fast with the order. The rye toast and breakfast sausage were also very good. The place has that nice well worn ambiance. Lots of locals here too, that speaks volumes to the quality."</p>
                  <p class="review-author">- Steve P., Google Review</p>
                </div>
              </div>
              <button class="carousel-btn next" id="nextReview" aria-label="Next review">&rsaquo;</button>
            </div>
            <div class="carousel-dots" id="carouselDots"></div>
          </div>
        </div>
      </div>
    </section>

    <section class="faq-section">
      <div class="container">
        <h2>Common Questions</h2>
        <div class="faq-list">
          <div class="faq-item">
            <h3>What are your hours?</h3>
            <p>Monday&ndash;Friday: 6:00am&ndash;2:00pm &nbsp;&middot;&nbsp; Saturday: 6:00am&ndash;1:30pm &nbsp;&middot;&nbsp; Sunday: 6:30am&ndash;1:00pm</p>
          </div>
          <div class="faq-item">
            <h3>Where are you located?</h3>
            <p>409 Broadway, Chicopee, MA 01020 &mdash; serving Chicopee, Springfield, Holyoke, and all of Hampden County.</p>
          </div>
          <div class="faq-item">
            <h3>Do you offer takeout or delivery?</h3>
            <p>Yes! Call <a href="tel:+14135948332">(413) 594-8332</a> for takeout, or order delivery through <a href={DOORDASH_URL} target="_blank" rel="noopener">DoorDash</a>.</p>
          </div>
          <div class="faq-item">
            <h3>What are you known for?</h3>
            <p>House-made eggs benedict with our signature hollandaise sauce, homemade corned beef hash, and French toast &mdash; named Best French Toast in Western Massachusetts by WWLP 22News.</p>
          </div>
        </div>
        <p class="faq-see-all"><a href="/faq">See all 23 frequently asked questions &rarr;</a></p>
      </div>
    </section>
  </main>
</BaseLayout>
